# Copy to .env and fill in what you need — every key is optional.
# The LLM chain falls back: Claude > OpenAI > local Ollama.

# --- AI providers -----------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b

# --- Search tuning (optional overrides) ------------------------------------
# QUERIES=AI Engineer,Machine Learning Engineer,LLM Engineer,GenAI Engineer
# JOB_LOCATION=United Arab Emirates
# SOURCES=linkedin,indeed,naukri,bayt,gulftalent
# MIN_SCORE=70
# PREP_LIMIT=5

# --- Notifications: configure ANY subset; unset channels are skipped --------
# Telegram: message @BotFather for a token, then get your chat id via @userinfobot
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=123456789

# Email (SMTP). Port 465 uses SSL, anything else tries STARTTLS.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=app-specific-password
# EMAIL_TO=you@gmail.com
# EMAIL_FROM=you@gmail.com

# Slack incoming webhook
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# --- LinkedIn (optional) -----------------------------------------------------
# Preferred (safe): run `python3 main.py linkedin-login` and log in in the opened
# window (uses your Chrome profile; password never stored on disk).
# Credential autofill is OPT-IN ONLY: set ALLOW_STORED_CREDENTIALS=1 AND fill
# the email/password below. This stores the plaintext password in .env — only
# do this on a machine you fully control, and NEVER share .env.
# ALLOW_STORED_CREDENTIALS=1
# LINKEDIN_EMAIL=
# LINKEDIN_PASSWORD=

# --- Indeed (optional) -------------------------------------------------------
# Preferred (safe): run `python3 main.py indeed-login` and log in in the opened
# window (uses your Chrome profile; password never stored on disk).
# Credential autofill is OPT-IN ONLY — see ALLOW_STORED_CREDENTIALS above.
# ALLOW_STORED_CREDENTIALS=1
# INDEED_EMAIL=
# INDEED_PASSWORD=

# --- Naukri (optional) -------------------------------------------------------
# Preferred (safe): run `python3 main.py naukri-login` and log in in the opened
# window (uses your Chrome profile; password never stored on disk).
# Credential autofill is OPT-IN ONLY — see ALLOW_STORED_CREDENTIALS above.
# ALLOW_STORED_CREDENTIALS=1
# NAUKRI_EMAIL=
# NAUKRI_PASSWORD=

# --- Auto-apply (submits applications for you) ------------------------------
# Turn on for the daily run (`python3 main.py run`), or pass --auto-apply / use
# `python3 main.py autoapply` manually. Only touches prepped 'ready' jobs.
# AUTO_APPLY=1
# AUTO_APPLY_LIMIT=3                 # max submissions per run
# AUTO_APPLY_MIN_SCORE=70            # below this, jobs stay queued
# AUTO_APPLY_HEADLESS=1              # no browser window during the run

# --- Scheduler (optional) ---------------------------------------------------
# Extra flags for the daily launchd run (scripts/daily.sh)
# COPILOT_FLAGS=--playwright
